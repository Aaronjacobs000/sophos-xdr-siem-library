{
  "name": "sophos-xdr-siem-library",
  "version": "0.1.0",
  "description": "Unofficial Sophos Fusion XDR and SIEM Library: custom parsers for Sophos NG-SIEM that people share, and Parser Studio to write and test your own in the browser. Unofficial project, not from Sophos.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Aaron Jacobs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aaronjacobs000/sophos-xdr-siem-library.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "validate": "node tools/validate-library.mjs --all",
    "build": "node tools/build-site.mjs",
    "serve": "node tools/serve.mjs",
    "emulate": "node tools/emulate.mjs",
    "expected": "node tools/update-expected.mjs",
    "schemas": "node tools/build-schemas.mjs",
    "check": "node --test \"test/*.test.mjs\" && node tools/validate-library.mjs --all"
  }
}
